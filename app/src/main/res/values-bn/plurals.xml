<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Counting how many songs are in a song list -->
    <plurals name="songs">
        <item quantity="one">%dটি গান</item>
        <item quantity="other">%dটি গান</item>
    </plurals>

    <!-- Counting how many albums are in an album list -->
    <plurals name="albums">
        <item quantity="one">%dটি অ্যালবাম</item>
        <item quantity="other">%dটি অ্যালবাম</item>
    </plurals>

    <!-- Counting how many artists are in an artist list -->
    <plurals name="artists">
        <item quantity="one">%dজন শিল্পী</item>
        <item quantity="other">%dজন শিল্পী</item>
    </plurals>

    <!-- Counting how many items are in an misc list (eg playlists, years, etc) -->
    <plurals name="items">
        <item quantity="one">%dটি আইটেম</item>
        <item quantity="other">%dটি আইটেম</item>
    </plurals>

    <!-- Counting how many folders are in an folder list -->
    <plurals name="folders_plural">
        <item quantity="one">%dটি ফোল্ডার</item>
        <item quantity="other">%dটি ফোল্ডার</item>
    </plurals>

    <!-- Used in sleep timer dialog to show list of 1/2/3/5/10/15/etc minutes for user to quickly pick from -->
    <plurals name="minutes">
        <item quantity="one">%d মিনিট</item>
        <item quantity="other">%d মিনিট</item>
    </plurals>

</resources>

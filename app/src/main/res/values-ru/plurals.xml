<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Counting how many songs are in a song list -->
    <plurals name="songs">
        <item quantity="one">%d трек</item>
        <item quantity="few">%d трека</item>
        <item quantity="many">%d треков</item>
        <item quantity="other">%d трека</item>
    </plurals>

    <!-- Counting how many albums are in an album list -->
    <plurals name="albums">
        <item quantity="one">%d альбом</item>
        <item quantity="few">%d альбома</item>
        <item quantity="many">%d альбомов</item>
        <item quantity="other">%d альбома</item>
    </plurals>

    <!-- Counting how many artists are in an artist list -->
    <plurals name="artists">
        <item quantity="one">%d исполнитель</item>
        <item quantity="few">%d исполнителя</item>
        <item quantity="many">%d исполнителей</item>
        <item quantity="other">%d исполнителя</item>
    </plurals>

    <!-- Counting how many items are in an misc list (eg playlists, years, etc) -->
    <plurals name="items">
        <item quantity="one">%d элемент</item>
        <item quantity="few">%d элемента</item>
        <item quantity="many">%d элементов</item>
        <item quantity="other">%d элемента</item>
    </plurals>

    <!-- Counting how many folders are in an folder list -->
    <plurals name="folders_plural">
        <item quantity="one">%d папка</item>
        <item quantity="few">%d папки</item>
        <item quantity="many">%d папок</item>
        <item quantity="other">%d папки</item>
    </plurals>

    <!-- Used in sleep timer dialog to show list of 1/2/3/5/10/15/etc minutes for user to quickly pick from -->
    <plurals name="minutes">
        <item quantity="one">%d минута</item>
        <item quantity="few">%d минуты</item>
        <item quantity="many">%d минут</item>
        <item quantity="other">%d минуты</item>
    </plurals>

</resources>

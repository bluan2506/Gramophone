<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Counting how many songs are in a song list -->
    <plurals name="songs">
        <item quantity="one">%d titre</item>
        <item quantity="many">%d de titres</item>
        <item quantity="other">%d titres</item>
    </plurals>

    <!-- Counting how many albums are in an album list -->
    <plurals name="albums">
        <item quantity="one">%d album</item>
        <item quantity="many">%d d\'albums</item>
        <item quantity="other">%d albums</item>
    </plurals>

    <!-- Counting how many artists are in an artist list -->
    <plurals name="artists">
        <item quantity="one">%d artiste</item>
        <item quantity="many">%d d\'artistes</item>
        <item quantity="other">%d artistes</item>
    </plurals>

    <!-- Counting how many items are in an misc list (eg playlists, years, etc) -->
    <plurals name="items">
        <item quantity="one">%d élément</item>
        <item quantity="many">%d d\'éléments</item>
        <item quantity="other">%d éléments</item>
    </plurals>

    <!-- Counting how many folders are in an folder list -->
    <plurals name="folders_plural">
        <item quantity="one">%d dossier</item>
        <item quantity="many">%d de dossiers</item>
        <item quantity="other">%d dossiers</item>
    </plurals>

    <!-- Used in sleep timer dialog to show list of 1/2/3/5/10/15/etc minutes for user to quickly pick from -->
    <plurals name="minutes">
        <item quantity="one">%d minute</item>
        <item quantity="many">%d de minutes</item>
        <item quantity="other">%d minutes</item>
    </plurals>

</resources>

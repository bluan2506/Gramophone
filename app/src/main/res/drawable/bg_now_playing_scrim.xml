<?xml version="1.0" encoding="utf-8"?>
<!-- Scrim behind the now-playing equalizer when it sits on a tile drawn with a background shape
     instead of a (clipping) MaterialCardView. Corner radius must track @drawable/bg_home_icon. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#73000000" />
    <corners android:radius="15dp" />
</shape>

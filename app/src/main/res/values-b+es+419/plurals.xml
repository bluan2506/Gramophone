<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Counting how many songs are in a song list -->
    <plurals name="songs">
        <item quantity="one">%d canción</item>
        <item quantity="many">%d de canciones</item>
        <item quantity="other">%d canciones</item>
    </plurals>

    <!-- Counting how many albums are in an album list -->
    <plurals name="albums">
        <item quantity="one">%d álbum</item>
        <item quantity="many">%d de álbumes</item>
        <item quantity="other">%d álbumes</item>
    </plurals>

    <!-- Counting how many artists are in an artist list -->
    <plurals name="artists">
        <item quantity="one">%d artista</item>
        <item quantity="many">%d de artistas</item>
        <item quantity="other">%d artistas</item>
    </plurals>

    <!-- Counting how many items are in an misc list (eg playlists, years, etc) -->
    <plurals name="items">
        <item quantity="one">%d elemento</item>
        <item quantity="many">%d de elementos</item>
        <item quantity="other">%d elementos</item>
    </plurals>

    <!-- Counting how many folders are in an folder list -->
    <plurals name="folders_plural">
        <item quantity="one">%d carpeta</item>
        <item quantity="many">%d de carpetas</item>
        <item quantity="other">%d carpetas</item>
    </plurals>

    <!-- Used in sleep timer dialog to show list of 1/2/3/5/10/15/etc minutes for user to quickly pick from -->
    <plurals name="minutes">
        <item quantity="one">%d minuto</item>
        <item quantity="many">%d de minutos</item>
        <item quantity="other">%d minutos</item>
    </plurals>

</resources>

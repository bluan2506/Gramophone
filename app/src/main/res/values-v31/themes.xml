<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Day.Theme.Splash" parent="Impl.Day.Theme.Splash" />

    <style name="Night.Theme.Splash" parent="Impl.Night.Theme.Splash" />

    <!--
        Inherits V30 (and therefore the brand colour block + the cutout/forceDark window flags)
        instead of jumping straight back to the base theme; on API 31+ this only swaps in the
        platform widget corner radii.
    -->
    <style name="Theme.MusicDownloader" parent="V30.Theme.MusicDownloader">
        <item name="system_app_widget_background_radius">
            @android:dimen/system_app_widget_background_radius
        </item>
        <item name="system_app_widget_inner_radius">@android:dimen/system_app_widget_inner_radius
        </item>
    </style>
</resources>

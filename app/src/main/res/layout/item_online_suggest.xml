<?xml version="1.0" encoding="utf-8"?>
<!-- Search suggestion: the leading glyph now sits in a tinted tile, matching every other
     leading icon in the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_icon_tile">

        <ImageView
            android:id="@+id/img_search"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorOnSurfaceVariant" />
    </FrameLayout>

    <TextView
        android:id="@+id/text_suggest"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.App.ItemTitle"
        android:textSize="15sp"
        tools:text="Suggestion" />

    <ImageView
        android:id="@+id/img_up"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:padding="8dp"
        android:rotation="45"
        android:src="@drawable/baseline_arrow_upward_24"
        app:tint="?attr/colorOutline" />

</LinearLayout>

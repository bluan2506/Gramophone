<?xml version="1.0" encoding="utf-8"?>
<!--
    Library list row. Changes vs the old row: larger, much rounder artwork; the now-playing
    equalizer moved on top of the artwork (behind a scrim) instead of sitting between the text
    and the overflow; and the overflow shrunk to a small circular ghost button so the row reads
    as artwork + text rather than artwork + text + toolbar.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_height"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="20dp"
    android:paddingEnd="10dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/coverCardView"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="@dimen/list_round_corner_size"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_default_cover" />

        <ImageView
            android:id="@+id/now_playing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#73000000"
            android:contentDescription="@string/now_playing"
            android:padding="15dp"
            android:visibility="gone"
            app:tint="@android:color/white" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.App.ItemTitle"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/artist"
        app:layout_constraintEnd_toStartOf="@id/more"
        app:layout_constraintStart_toEndOf="@id/coverCardView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Example Title" />

    <TextView
        android:id="@+id/artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.App.ItemSubtitle"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/more"
        app:layout_constraintStart_toEndOf="@id/coverCardView"
        app:layout_constraintTop_toBottomOf="@id/title"
        tools:text="Example Artist" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/more"
        style="@style/Widget.App.IconButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@string/more"
        app:icon="@drawable/ic_more_vert_alt"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="20dp"
        app:iconTint="?attr/colorOutline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tooltipText="@string/more" />

</androidx.constraintlayout.widget.ConstraintLayout>

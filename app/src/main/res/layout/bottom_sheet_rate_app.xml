<?xml version="1.0" encoding="utf-8"?>
<!-- Rate sheet: the illustration is now a bleed-to-edge banner with the copy and the rating
     stacked on a tighter rhythm, and the CTA is the primary pill. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:nestedScrollingEnabled="true"
    android:scrollbars="vertical"
    tools:context=".ui.components.RateAppBottomSheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/img_star"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/image"
            android:src="@drawable/ic_star_5" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="@string/rate_app_title"
            android:textAppearance="@style/TextAppearance.App.ScreenTitle.Small"
            android:textSize="18sp" />

        <RatingBar
            android:id="@+id/rating_bar"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="24dp"
            android:numStars="5"
            android:progressDrawable="@drawable/rating_bar"
            android:stepSize="1"
            tools:rating="3" />

        <TextView
            android:id="@+id/tv_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_button_primary"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingVertical="15dp"
            android:text="@string/rate"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            app:textFontWeight="700" />

    </LinearLayout>

</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Album / genre / playlist detail. Was a 152dp "Large" collapsing header with a huge title that
    scaled away on scroll; now a static compact header on one line, matching Downloads and the
    online search screen. The CollapsingToolbarLayout is kept because the fragment sets its
    title, but it no longer scrolls or scales - both title appearances are identical.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbarlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stateListAnimator="@null"
        app:liftOnScroll="true"
        app:liftOnScrollColor="?attr/colorSurfaceContainerLow">

        <!--
            Plain header instead of a CollapsingToolbarLayout: with a pinned toolbar filling a
            68dp bar the collapsing widget's expanded-title box is zero-height and the title is
            never drawn. The MaterialToolbar stays (it owns the nav icon and the menu); the title
            is a real TextView, set via R.id.header_title.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="68dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/topAppBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="0dp"
                app:contentInsetStartWithNavigation="6dp"
                app:navigationContentDescription="@string/back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="60dp"
                android:layout_marginEnd="112dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_accent_bar" />

                <TextView
                    android:id="@+id/header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.ScreenTitle.Small" />

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <include
        layout="@layout/fragment_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

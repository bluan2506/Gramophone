<?xml version="1.0" encoding="utf-8"?><!-- Full Player Layout -->
<!--
    Reordered from the original stack. Was:
        header / cover / title / slider / [position | quality | duration] / transport / actions
    Now:
        header / cover / actions / title / [position | slider | duration] / quality / transport

    The five secondary actions move up under the artwork so the bottom of the screen belongs to
    the transport row, and the elapsed/remaining times move inline to either side of the scrubber
    instead of sitting on their own line underneath it.

    Colours here are only the starting values for FullBottomSheet#applyColorScheme, which
    re-tints the title, mid button, slider, and every icon at runtime (optionally from the album
    art), so the attributes on those specific views are deliberately unchanged.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/full_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/slide_down"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/rp_buttons"
        android:contentDescription="@string/expand_less"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_expand_more"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="26dp"
        app:iconTint="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tooltipText="@string/expand_less" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/playback_speed"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/rp_buttons"
        android:contentDescription="@string/playback_speed"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_speed"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="23dp"
        app:iconTint="?attr/colorOnSurface"
        app:layout_constraintBottom_toBottomOf="@id/slide_down"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/slide_down"
        app:tooltipText="@string/playback_speed" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/timer"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/rp_buttons"
        android:checkable="true"
        android:contentDescription="@string/timer"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:saveEnabled="false"
        app:icon="@drawable/sl_check_timer"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="23dp"
        app:iconTint="?attr/colorOnSurface"
        app:layout_constraintBottom_toBottomOf="@id/slide_down"
        app:layout_constraintEnd_toStartOf="@id/playback_speed"
        app:layout_constraintTop_toTopOf="@id/slide_down"
        app:toggleCheckedStateOnClick="false"
        app:tooltipText="@string/timer" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/album_cover_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/slide_down"
        app:strokeWidth="0dp">

        <com.musicdownloader.musicfreeapp825v2.ui.components.TransformableImageView
            android:id="@+id/full_sheet_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/dialog_album"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_default_cover" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Secondary actions, directly under the artwork. -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/album_cover_frame">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lyrics"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/rp_buttons"
            android:checkable="true"
            android:contentDescription="@string/dialog_lyrics"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:saveEnabled="false"
            app:icon="@drawable/ic_article"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="23dp"
            app:iconTint="?attr/colorOnSurface"
            app:tooltipText="@string/dialog_lyrics" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_loop"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/rp_buttons"
            android:checkable="true"
            android:contentDescription="@string/repeat_mode"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:saveEnabled="false"
            app:icon="@drawable/ic_repeat"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="23dp"
            app:iconTint="@color/sl_check_button"
            app:tooltipText="@string/repeat_mode" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_random"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/rp_buttons"
            android:checkable="true"
            android:contentDescription="@string/shuffle"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:saveEnabled="false"
            app:icon="@drawable/ic_shuffle"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="23dp"
            app:iconTint="@color/sl_check_button"
            app:tooltipText="@string/shuffle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/favor"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/rp_buttons"
            android:checkable="true"
            android:contentDescription="@string/playlist_favourite"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:saveEnabled="false"
            app:icon="@drawable/sl_check_fav"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="23dp"
            app:iconTint="@color/sl_fav_button"
            app:tooltipText="@string/playlist_favourite" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playlist"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/rp_buttons"
            android:contentDescription="@string/current_playlist"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_playlist_play"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="23dp"
            app:iconTint="?attr/colorOnSurface"
            app:tooltipText="@string/current_playlist" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="230dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/actionBar">

        <LinearLayout
            android:id="@+id/textLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="28dp"
            android:minHeight="62dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/slider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <com.musicdownloader.musicfreeapp825v2.ui.components.MarqueeTextView
                android:id="@+id/full_song_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:scrollbars="none"
                android:textColor="?colorPrimary"
                android:textSize="24sp"
                app:textFontWeight="700"
                tools:text="Artifiction" />

            <com.musicdownloader.musicfreeapp825v2.ui.components.MarqueeTextView
                android:id="@+id/full_song_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:scrollbars="none"
                android:textColor="?colorSecondary"
                android:textSize="15sp"
                app:textFontWeight="500"
                tools:text="Artifiction" />

        </LinearLayout>

        <!-- Elapsed / remaining now flank the scrubber instead of sitting on their own row. -->
        <TextView
            android:id="@+id/position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:fontFamily="monospace"
            android:text="@string/default_time"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/slider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/slider"
            app:textFontWeight="600" />

        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="28dp"
            android:fontFamily="monospace"
            android:text="@string/default_time"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/slider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/slider"
            app:textFontWeight="600" />

        <FrameLayout
            android:id="@+id/slider"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toTopOf="@id/quality_details"
            app:layout_constraintEnd_toStartOf="@id/duration"
            app:layout_constraintStart_toEndOf="@id/position"
            app:layout_constraintTop_toBottomOf="@id/textLayout">

            <!-- min/maxHeight needed for Android L to center SeekBar thumb -->
            <SeekBar
                android:id="@+id/slider_squiggly"
                style="@style/MediaPlayer.ProgressBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@string/position_slider"
                android:maxHeight="48dp"
                android:minHeight="48dp"
                android:progress="0"
                android:thumbTint="?attr/colorPrimary"
                android:visibility="gone"
                app:labelBehavior="gone"
                tools:ignore="DuplicateClickableBoundsCheck"
                tools:progress="20"
                tools:visibility="visible" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_vert"
                style="@style/Widget.Material3.Slider.Legacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@string/position_slider"
                android:value="0"
                android:valueTo="1"
                android:visibility="gone"
                app:labelBehavior="gone"
                app:thumbElevation="0dp"
                app:thumbHeight="22dp"
                app:thumbWidth="6dp"
                app:trackHeight="6dp"
                tools:value="0.5"
                tools:visibility="visible" />

        </FrameLayout>

        <TextView
            android:id="@+id/quality_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="28dp"
            android:drawablePadding="6dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11.5sp"
            app:drawableTint="?attr/colorOnSurfaceVariant"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@id/sheet_mid_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/slider"
            app:textFontWeight="600"
            tools:drawableStartCompat="@drawable/ic_high_res"
            tools:text="16-bit / 44.1KHz / 2ch" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_mid_button"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_play_anim"
            android:contentDescription="@string/play"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="?attr/colorSecondaryContainer"
            app:icon="@drawable/play_anim"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="40dp"
            app:iconTint="?attr/colorOnSecondaryContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/quality_details"
            app:tooltipText="@string/play" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_previous_song"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:background="@drawable/rp_buttons_dynamic"
            android:contentDescription="@string/skip_previous"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_skip_previous"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="34dp"
            app:iconTint="?attr/colorOnSurface"
            app:layout_constraintBottom_toBottomOf="@id/sheet_mid_button"
            app:layout_constraintEnd_toStartOf="@id/sheet_mid_button"
            app:layout_constraintHorizontal_bias="0.75"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/sheet_mid_button"
            app:tooltipText="@string/skip_previous" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_next_song"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:background="@drawable/rp_buttons_dynamic"
            android:contentDescription="@string/skip_next"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_skip_next"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="34dp"
            app:iconTint="?attr/colorOnSurface"
            app:layout_constraintBottom_toBottomOf="@id/sheet_mid_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintStart_toEndOf="@id/sheet_mid_button"
            app:layout_constraintTop_toTopOf="@id/sheet_mid_button"
            app:tooltipText="@string/skip_next" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</merge>

<?xml version="1.0" encoding="utf-8"?>
<!--
    List header. Was: plain counter on the left, a row of flat square icon buttons on the right.
    Now: an eyebrow-styled counter under an accent rule, with the actions as small circular
    tonal buttons so they read as a cluster rather than a toolbar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/decor_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="12dp">

    <View
        android:layout_width="3dp"
        android:layout_height="16dp"
        android:background="@drawable/bg_accent_bar" />

    <TextView
        android:id="@+id/song_counter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.App.Eyebrow"
        tools:text="0 Song" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/create_playlist"
        style="@style/Widget.App.IconButton.Surface"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/create_playlist"
        android:visibility="gone"
        app:icon="@drawable/outline_add_24"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="20dp"
        app:iconTint="?attr/colorPrimary"
        app:tooltipText="@string/create_playlist"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/play_all"
        style="@style/Widget.App.IconButton.Surface"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/play_all"
        android:visibility="gone"
        app:backgroundTint="?attr/colorPrimaryContainer"
        app:icon="@drawable/ic_play_arrow_filled"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="18dp"
        app:iconTint="?attr/colorOnPrimaryContainer"
        app:tooltipText="@string/play_all"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/shuffle_all"
        style="@style/Widget.App.IconButton.Surface"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/shuffle_all"
        android:visibility="gone"
        app:icon="@drawable/ic_shuffle"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="19dp"
        app:iconTint="?attr/colorPrimary"
        app:tooltipText="@string/shuffle_all"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sort"
        style="@style/Widget.App.IconButton.Surface"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/sort"
        app:icon="@drawable/ic_sort"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="19dp"
        app:iconTint="?attr/colorPrimary"
        app:tooltipText="@string/sort" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/jumpUp"
        style="@style/Widget.App.IconButton.Surface"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/scroll_to_albums"
        android:visibility="gone"
        app:icon="@drawable/baseline_arrow_upward_24"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="19dp"
        app:iconTint="?attr/colorPrimary"
        app:tooltipText="@string/scroll_to_albums"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/jumpDown"
        style="@style/Widget.App.IconButton.Surface"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/scroll_to_songs"
        android:visibility="gone"
        app:icon="@drawable/baseline_arrow_downward_24"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="19dp"
        app:iconTint="?attr/colorPrimary"
        app:tooltipText="@string/scroll_to_songs"
        tools:visibility="visible" />

</LinearLayout>

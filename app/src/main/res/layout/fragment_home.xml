<?xml version="1.0" encoding="utf-8"?>
<!--
    Home. Landing page modelled on the MSDownloader home: the app mark, one search entry that
    hands off to the online search screen, a cloud of "hot song" keywords that jump straight into
    a search, and two tiles for the sub-screens (Downloaded, Settings).

    Everything is sized to fit one screen without scrolling. The budget is tighter than the
    reference's: on top of the app bar this screen also sits above the mini player, the bottom
    navigation and a banner ad, which leaves roughly 550dp of content height on a normal phone.
    Hence the compact metrics here (68dp mark, 56dp search bar, 32dp chips, 68dp tiles) and the
    trimmed keyword list in R.array.home_hot_songs — four chip rows is what fits.

    Colours are theme attributes, not the reference's literal blue, so the screen stays in the
    app palette and follows light/dark. The Search button is the only fully saturated surface,
    which keeps it the unambiguous primary action.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".ui.fragments.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="20dp">

        <!-- ================================ Brand ================================ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/ic_launcher_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <!-- The launcher foreground keeps the adaptive-icon safe zone, which leaves the mark
                 small inside a plain tile; scaled up so it fills the tile like the real icon. -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleX="1.45"
                android:scaleY="1.45"
                android:src="@drawable/ic_launcher_foreground" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================ Search hand-off ============================ -->
        <!--
            Not a real input: tapping anywhere on the pill (field or button) opens the online
            search screen, which owns the actual EditText, suggestions and history.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_search"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_search_free_hint"
                    android:textColor="?attr/colorOutline"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_search_button"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/home_search_action"
                    android:textSize="14sp"
                    app:elevation="0dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================== Hot songs ============================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_accent_bar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:text="@string/home_hot_songs"
                android:textColor="?attr/colorPrimary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:textFontWeight="700" />

        </LinearLayout>

        <!-- Filled at runtime from R.array.home_hot_songs (see HomeFragment#populateHotSongs). -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/hot_songs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleLine="false" />

        <!-- ========================== Sub-screen entries ========================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_downloaded"
                style="@style/Widget.App.Card.Outlined"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_home_icon">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/home_downloaded"
                            android:src="@drawable/ic_download"
                            app:tint="?attr/colorOnPrimaryContainer" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/home_downloaded"
                            android:textAppearance="@style/TextAppearance.App.ItemTitle"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/card_downloaded_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.ItemSubtitle"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_settings"
                style="@style/Widget.App.Card.Outlined"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_home_icon">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/home_settings"
                            android:src="@drawable/ic_settings"
                            app:tint="?attr/colorOnPrimaryContainer" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/home_settings"
                            android:textAppearance="@style/TextAppearance.App.ItemTitle"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/home_settings_subtitle"
                            android:textAppearance="@style/TextAppearance.App.ItemSubtitle"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

<!-- The value now reads as a pill-ish monospace badge next to the title, and the whole row uses
     the same 20dp gutter as the other preference rows. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="13dp">

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical">

        <LinearLayout
            android:id="@+id/icon_frame"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_icon_tile"
            android:gravity="center">

            <ImageView
                android:id="@android:id/icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                app:tint="?attr/colorPrimary"
                tools:src="@drawable/ic_info" />

        </LinearLayout>

        </FrameLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical">

            <!-- For better RTL support -->
            <LinearLayout
                android:id="@+id/title_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@id/seekbar_value">

                <TextView
                    android:id="@android:id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.ItemTitle"
                    android:textSize="16sp"
                    tools:text="Title" />

            </LinearLayout>

            <TextView
                android:id="@+id/seekbar_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/title_container"
                android:layout_alignParentEnd="true"
                android:fontFamily="monospace"
                android:gravity="end"
                android:minWidth="40dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                app:textFontWeight="700"
                tools:text="50" />

            <SeekBar
                android:id="@id/seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/title_container"
                android:layout_marginTop="6dp"
                android:background="@null"
                android:contentDescription="@string/seekbar"
                android:progress="50"
                android:progressTint="?attr/colorPrimary"
                android:thumbTint="?attr/colorPrimary" />

        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

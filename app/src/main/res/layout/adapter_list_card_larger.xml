<?xml version="1.0" encoding="utf-8"?>
<!-- Roomier variant of adapter_list_card, same anatomy at a larger scale. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/larger_list_height"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="20dp"
    android:paddingEnd="10dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/coverCardView"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_default_cover" />

        <ImageView
            android:id="@+id/now_playing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#73000000"
            android:contentDescription="@string/now_playing"
            android:padding="17dp"
            android:visibility="gone"
            app:tint="@android:color/white" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.App.ItemTitle"
        android:textSize="16.5sp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/artist"
        app:layout_constraintEnd_toStartOf="@id/more"
        app:layout_constraintStart_toEndOf="@id/coverCardView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Example Title" />

    <TextView
        android:id="@+id/artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.App.ItemSubtitle"
        android:textSize="13.5sp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/more"
        app:layout_constraintStart_toEndOf="@id/coverCardView"
        app:layout_constraintTop_toBottomOf="@id/title"
        tools:text="Example Artist" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/more"
        style="@style/Widget.App.IconButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@string/more"
        app:icon="@drawable/ic_more_vert_alt"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="20dp"
        app:iconTint="?attr/colorOutline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tooltipText="@string/more" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Downloaded file row: primary-tinted tile, then title/size, then a play chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="11dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_home_icon">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_songs"
            app:tint="?attr/colorOnPrimaryContainer" />

        <!-- Now-playing equalizer over the tile behind a scrim, as in adapter_list_card.xml and
             item_online_song.xml. The tile is a background shape, not a clipping card, so the
             scrim carries the rounding itself (@drawable/bg_now_playing_scrim). -->
        <ImageView
            android:id="@+id/now_playing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_now_playing_scrim"
            android:contentDescription="@string/now_playing"
            android:padding="14dp"
            android:visibility="gone"
            app:tint="@android:color/white"
            tools:src="@drawable/ic_play_arrow_filled"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.ItemTitle"
            tools:text="Downloaded song.m4a" />

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.ItemSubtitle"
            tools:text="3.2 MB" />
    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_play_arrow"
        app:tint="?attr/colorOutline" />

</LinearLayout>

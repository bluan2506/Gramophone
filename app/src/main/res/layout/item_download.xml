<?xml version="1.0" encoding="utf-8"?>
<!--
    Downloaded file row: artwork card, then title/size, then a play chevron. The card mirrors the
    library list row (adapter_list_card.xml) — same size, corner radius, surface colour and
    @drawable/ic_default_cover placeholder — so downloads read like the Songs list. Downloads have
    no artwork source yet, so the placeholder is what is actually shown.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="11dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="@dimen/list_round_corner_size"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_default_cover" />

        <!-- Now-playing equalizer over the artwork behind a scrim, as in adapter_list_card.xml and
             item_online_song.xml. The card clips its children, so a plain scrim colour is enough. -->
        <ImageView
            android:id="@+id/now_playing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#73000000"
            android:contentDescription="@string/now_playing"
            android:padding="15dp"
            android:visibility="gone"
            app:tint="@android:color/white"
            tools:src="@drawable/ic_play_arrow_filled"
            tools:visibility="visible" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.ItemTitle"
            tools:text="Downloaded song.m4a" />

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.ItemSubtitle"
            tools:text="3.2 MB" />
    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_play_arrow"
        app:tint="?attr/colorOutline" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <!-- Same cover cell as the offline song list (adapter_list_card.xml): filled card at
         list_round_corner_size with the shared ic_default_cover placeholder. -->
    <com.google.android.material.card.MaterialCardView
        style="?materialCardViewFilledStyle"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:cardCornerRadius="@dimen/list_round_corner_size">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="?attr/colorSurfaceContainer"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_default_cover" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="Downloaded song.m4a" />

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="3.2 MB" />
    </LinearLayout>

    <!-- Trailing "now playing" equalizer, same placement/tint as the offline song lists
         (adapter_list_card.xml) so the indicator reads identically across screens. -->
    <ImageView
        android:id="@+id/now_playing"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/now_playing"
        android:padding="12dp"
        android:visibility="gone"
        app:tint="?attr/colorOnSurface"
        tools:src="@drawable/ic_play_arrow_filled"
        tools:visibility="visible" />

</LinearLayout>

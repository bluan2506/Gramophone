<?xml version="1.0" encoding="utf-8"?>
<!-- "Are you enjoying the app?" sheet. The two choices are no longer two identical filled
     buttons: the positive one is the primary pill, the other an outlined pill. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:nestedScrollingEnabled="true"
    android:scrollbars="vertical"
    tools:context=".ui.components.SatisfiedBottomSheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/image"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/satisfied"
            android:textAppearance="@style/TextAppearance.App.ScreenTitle.Small"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/tv_good"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingVertical="15dp"
            android:text="@string/good"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            app:textFontWeight="700" />

        <TextView
            android:id="@+id/tv_not_really"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_secondary"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingVertical="15dp"
            android:text="@string/not_really"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            app:textFontWeight="600" />

    </LinearLayout>

</ScrollView>

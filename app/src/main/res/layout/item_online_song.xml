<?xml version="1.0" encoding="utf-8"?>
<!--
    Online search result. The download action is now a filled circular button rather than a grey
    ghost icon, because downloading is the point of this screen and it should read as an action,
    not as a decoration.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="12dp"
    android:paddingVertical="9dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="58dp"
        android:layout_height="58dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/image_music"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/now_playing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#73000000"
            android:contentDescription="@string/now_playing"
            android:padding="16dp"
            android:visibility="gone"
            app:tint="@android:color/white"
            tools:src="@drawable/ic_play_arrow_filled"
            tools:visibility="visible" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.App.ItemTitle"
            tools:text="Song title" />

        <TextView
            android:id="@+id/text_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.ItemSubtitle"
            tools:text="Artist · 3:45" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/image_download"
        style="@style/Widget.App.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@string/online_download"
        app:backgroundTint="?attr/colorPrimaryContainer"
        app:icon="@drawable/ic_download"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="22dp"
        app:iconTint="?attr/colorOnPrimaryContainer" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    tools:context=".ui.MainActivity">
    <!-- TODO do we even need animateLayoutChanges here? for what? -->

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:name="org.akanework.gramophone.ui.fragments.ViewPagerFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <org.akanework.gramophone.ui.components.PlayerBottomSheet
        android:id="@+id/player_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="?attr/colorSurfaceContainer"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="?attr/previewPlayerElevation"
        app:behavior_hideable="true"
        app:behavior_halfExpandedRatio="0.8"
        app:layout_behavior="org.akanework.gramophone.logic.ui.MyBottomSheetBehavior"
        app:marginLeftSystemWindowInsets="false"
        app:marginRightSystemWindowInsets="false"
        app:paddingBottomSystemWindowInsets="false"
        app:shapeAppearance="@style/BottomPlayerCornerShape"
        tools:behavior_peekHeight="1000dp" />

    <!-- Bottom bar = navigation on top + home banner ad below it (banner sits at the very bottom
         of the screen, under the nav). The bar owns the surface background + top hairline so the
         nav and the banner read as one bar; the system bottom inset is padded on the bar so the
         banner floats above the gesture area. bottomNavHeight measures this whole bar, so content
         and the mini player reserve space above the banner. -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:clipChildren="false"
        android:elevation="3dp"
        android:orientation="vertical">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:fitsSystemWindows="false"
            app:elevation="0dp"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

        <!-- Home banner ad (AdMob adaptive / TopOn), shown only after an ad loads -->
        <FrameLayout
            android:id="@+id/container_ads_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
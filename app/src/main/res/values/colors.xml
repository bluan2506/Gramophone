<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand palette: burnt orange (primary) + coral red (tertiary), on a warm neutral ramp.
    Tones are Material-3 style (tone == CIELAB L*) generated from a single orange source,
    so every role stays in one family. Backgrounds are deliberately pure #FFFFFF / #000000;
    the surfaceContainer ramp carries all the elevation separation instead.
-->

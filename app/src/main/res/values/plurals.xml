<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Counting how many songs are in a song list -->
    <plurals name="songs">
        <item quantity="one">%d Song</item>
        <item quantity="other">%d Songs</item>
    </plurals>

    <!-- Counting how many albums are in an album list -->
    <plurals name="albums">
        <item quantity="one">%d Album</item>
        <item quantity="other">%d Albums</item>
    </plurals>

    <!-- Counting how many artists are in an artist list -->
    <plurals name="artists">
        <item quantity="one">%d Artist</item>
        <item quantity="other">%d Artists</item>
    </plurals>

    <!-- Counting how many items are in an misc list (eg playlists, years, etc) -->
    <plurals name="items">
        <item quantity="one">%d Item</item>
        <item quantity="other">%d Items</item>
    </plurals>

    <!-- Counting how many folders are in an folder list -->
    <plurals name="folders_plural">
        <item quantity="one">%d Folder</item>
        <item quantity="other">%d Folders</item>
    </plurals>

    <!-- Used in sleep timer dialog to show list of 1/2/3/5/10/15/etc minutes for user to quickly pick from -->
    <plurals name="minutes">
        <item quantity="one">%d minute</item>
        <item quantity="other">%d minutes</item>
    </plurals>

</resources>

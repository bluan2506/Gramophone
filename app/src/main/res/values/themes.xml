<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Base application theme.

        Deliberately NOT Theme.Material3.DynamicColors.*: on Android 12+ that pulls the whole
        colour scheme out of the user's wallpaper, which would override the brand palette in
        values/colors.xml. The full player still opts into content-based colour separately
        (see FullBottomSheet#addColorScheme), which keeps working with a static base theme.
    -->
    <style name="Base.Theme.MusicDownloader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="viewInflaterClass">com.musicdownloader.musicfreeapp825v2.logic.ui.ViewCompatInflater</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.App.BodyLarge</item>
        <item name="collapsingToolbarLayoutLargeStyle">@style/CollapsingToolbarLarge</item>
        <item name="popupMenuBackground">@drawable/popup_background</item>
        <item name="alertDialogTheme">@style/AppTheme.AlertDialog</item>
        <item name="system_app_widget_background_radius">28dp</item>
        <item name="system_app_widget_inner_radius">20dp</item>
        <item name="previewPlayerElevation">1dp</item>

        <!-- Shape scale: the new design is squarer at the small end and much rounder at the
             large end than the stock Material ramp, which is a big part of the new silhouette. -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.App.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.App.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.ExtraLarge</item>

        <!-- Default component styling -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="borderlessButtonStyle">@style/Widget.App.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigation</item>
        <item name="sliderStyle">@style/Widget.App.Slider</item>
    </style>

    <style name="PreV31.Theme.MusicDownloader" parent="Base.Theme.MusicDownloader">
        <!-- Material theme -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/md_theme_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_inversePrimary</item>
        <item name="colorPrimaryFixed">@color/md_theme_primaryFixed</item>
        <item name="colorOnPrimaryFixed">@color/md_theme_onPrimaryFixed</item>
        <item name="colorPrimaryFixedDim">@color/md_theme_primaryFixedDim</item>
        <item name="colorOnPrimaryFixedVariant">@color/md_theme_onPrimaryFixedVariant</item>
        <item name="colorSecondaryFixed">@color/md_theme_secondaryFixed</item>
        <item name="colorOnSecondaryFixed">@color/md_theme_onSecondaryFixed</item>
        <item name="colorSecondaryFixedDim">@color/md_theme_secondaryFixedDim</item>
        <item name="colorOnSecondaryFixedVariant">@color/md_theme_onSecondaryFixedVariant</item>
        <item name="colorTertiaryFixed">@color/md_theme_tertiaryFixed</item>
        <item name="colorOnTertiaryFixed">@color/md_theme_onTertiaryFixed</item>
        <item name="colorTertiaryFixedDim">@color/md_theme_tertiaryFixedDim</item>
        <item name="colorOnTertiaryFixedVariant">@color/md_theme_onTertiaryFixedVariant</item>
        <item name="colorSurfaceDim">@color/md_theme_surfaceDim</item>
        <item name="colorSurfaceBright">@color/md_theme_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surfaceContainerHighest</item>
    </style>

    <style name="Theme.MusicDownloader" parent="PreV31.Theme.MusicDownloader" />

    <style name="Theme.MusicDownloader.PureDark" parent="Theme.MusicDownloader">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorSurfaceVariant">@android:color/black</item>
        <item name="colorSurfaceContainerLowest">@android:color/black</item>
        <item name="colorSurfaceContainerLow">@android:color/black</item>
        <item name="colorSurfaceContainer">@android:color/black</item>
        <item name="colorSurfaceContainerHigh">@android:color/black</item>
        <item name="colorSurfaceContainerHighest">@android:color/black</item>
        <item name="previewPlayerElevation">0dp</item>
    </style>

    <style name="ThemeOverlay.PureDark" parent="">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorSurfaceVariant">@android:color/black</item>
        <item name="colorSurfaceContainerLowest">@android:color/black</item>
        <item name="colorSurfaceContainerLow">@android:color/black</item>
        <item name="colorSurfaceContainer">@android:color/black</item>
        <item name="colorSurfaceContainerHigh">@android:color/black</item>
        <item name="colorSurfaceContainerHighest">@android:color/black</item>
        <item name="previewPlayerElevation">0dp</item>
    </style>

    <!-- ====================================================================================
         Shape scale
         ==================================================================================== -->

    <style name="ShapeAppearance.App.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>

    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.App.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.App.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>

    <!-- Fully rounded pill; used for every primary call to action. -->
    <style name="ShapeAppearance.App.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Cover art: list rows, grid tiles and the full player each get their own radius. -->
    <style name="ShapeAppearance.App.Cover.List" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.App.Cover.Grid" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="ShapeAppearance.App.Cover.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Top-rounded sheet: modal bottom sheets get a deep 32dp scoop. -->
    <style name="ShapeAppearance.App.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ====================================================================================
         Typography
         ==================================================================================== -->

    <style name="TextAppearance.App.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Small all-caps eyebrow above section content, with wide tracking. -->
    <style name="TextAppearance.App.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="textFontWeight">700</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">27sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="textFontWeight">700</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <!-- Sub-screen header title (back button + title on one line). -->
    <style name="TextAppearance.App.ScreenTitle.Small" parent="TextAppearance.App.ScreenTitle">
        <item name="android:textSize">21sp</item>
    </style>

    <style name="TextAppearance.App.ItemTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15.5sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="textFontWeight">600</item>
    </style>

    <style name="TextAppearance.App.ItemSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="textFontWeight">400</item>
    </style>

    <!-- Monospaced-feeling rank number in front of online results. -->
    <style name="TextAppearance.App.Rank" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOutline</item>
        <item name="android:fontFamily">monospace</item>
        <item name="textFontWeight">600</item>
    </style>

    <!-- ====================================================================================
         Components
         ==================================================================================== -->

    <!-- Every filled button is a pill; this alone re-silhouettes most of the app. -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">52dp</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
    </style>

    <!-- Tonal pill, for secondary actions. -->
    <style name="Widget.App.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- Circular ghost icon button; replaces the old square-ish 48dp MaterialButtons. -->
    <style name="Widget.App.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="iconSize">22dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- Icon button sitting inside a tinted circle, used across headers. -->
    <style name="Widget.App.IconButton.Surface" parent="Widget.App.IconButton">
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Large</item>
    </style>

    <!-- Outlined card: on a pure-white/pure-black background a hairline reads better than a
         near-invisible tonal fill, so most containers in the new design are outlined. -->
    <style name="Widget.App.Card.Outlined" parent="Widget.App.Card">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Home "hot song" keyword pill. Tonal rather than fully saturated: the cloud is a dozen-odd
         chips, so at full primary it would out-shout the single Search call to action. Sized so
         the whole cloud fits in four rows without pushing the tiles below it off-screen. -->
    <style name="Widget.App.Chip.Hot" parent="Widget.Material3.Chip.Assist">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="chipBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="rippleColor">?attr/colorOnPrimaryContainer</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Chip</item>
        <item name="android:checkable">false</item>
    </style>

    <style name="TextAppearance.App.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="textFontWeight">600</item>
    </style>

    <style name="Widget.App.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNavigation.Indicator</item>
        <item name="itemIconSize">23dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.App.NavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.App.NavLabel</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">10dp</item>
    </style>

    <style name="Widget.App.BottomNavigation.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">54dp</item>
        <item name="android:height">32dp</item>
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
    </style>

    <style name="TextAppearance.App.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="textFontWeight">500</item>
    </style>

    <style name="TextAppearance.App.NavLabel.Active" parent="TextAppearance.App.NavLabel">
        <item name="textFontWeight">700</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.App.Slider" parent="Widget.Material3.Slider">
        <item name="trackHeight">6dp</item>
        <item name="thumbElevation">0dp</item>
    </style>

    <!-- ====================================================================================
         Sheets, dialogs, misc (kept from the original where behaviour depends on them)
         ==================================================================================== -->

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ModalBottomSheetDialog</item>
        <item name="enableEdgeToEdge">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="ModalBottomSheetDialog" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.App.BottomSheet</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="marginLeftSystemWindowInsets">false</item>
        <item name="marginRightSystemWindowInsets">false</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>

    <style name="Base.TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="textFontWeight">600</item>
    </style>

    <style name="TabTextAppearance" parent="Base.TabTextAppearance" />

    <!-- The player sheet itself stays square: it slides up to fill the whole screen. -->
    <style name="BottomPlayerCornerShape">
        <item name="cornerSize">0dp</item>
    </style>

    <style name="CollapsingToolbarLarge" parent="Widget.Material3.CollapsingToolbar.Large">
        <item name="titleCollapseMode">scale</item>
        <item name="contentScrim">?attr/colorSurface</item>
    </style>

    <style name="MediaPlayer.ProgressBar" parent="@style/Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:thumb">@drawable/media_seekbar_thumb</item>
        <item name="android:thumbTint">?attr/colorPrimary</item>
        <item name="android:progressTint">?attr/colorPrimary</item>
        <item name="android:progressBackgroundTint">?attr/colorOutlineVariant</item>
        <item name="android:clickable">true</item>
        <item name="android:splitTrack">false</item>
    </style>

    <style name="Base.Night.Theme.Splash" parent="Theme.SplashScreen">
        <item name="viewInflaterClass">com.musicdownloader.musicfreeapp825v2.logic.ui.ViewCompatInflater</item>
        <item name="postSplashScreenTheme">@style/Theme.MusicDownloader</item>
    </style>

    <style name="Base.Day.Theme.Splash" parent="Base.Night.Theme.Splash" />

    <style name="Impl.Day.Theme.Splash" parent="Base.Day.Theme.Splash" />

    <style name="Impl.Night.Theme.Splash" parent="Base.Night.Theme.Splash" />

    <style name="PreV31Day.Theme.Splash" parent="Impl.Day.Theme.Splash">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>

    <style name="PreV31Night.Theme.Splash" parent="Impl.Night.Theme.Splash">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>

    <style name="Day.Theme.Splash" parent="PreV31Day.Theme.Splash" />

    <style name="Night.Theme.Splash" parent="PreV31Night.Theme.Splash" />

    <style name="Theme.Splash" parent="Day.Theme.Splash" />

    <style name="Theme.AudioPreviewDialogTheme" parent="Theme.MusicDownloader">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowBackground">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">32dp</item>
        <item name="cornerFamily">rounded</item>
        <item name="android:colorBackground">?attr/colorSurfaceContainerLow</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.App.Button.Text</item>
        <item name="android:layout" tools:ignore="PrivateResource">@layout/m3_alert_dialog</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Counting how many songs are in a song list -->
    <plurals name="songs">
        <item quantity="one">%d गाना</item>
        <item quantity="other">%d गाने</item>
    </plurals>

    <!-- Counting how many albums are in an album list -->
    <plurals name="albums">
        <item quantity="one">%d एल्बम</item>
        <item quantity="other">%d एल्बम</item>
    </plurals>

    <!-- Counting how many artists are in an artist list -->
    <plurals name="artists">
        <item quantity="one">%d कलाकार</item>
        <item quantity="other">%d कलाकार</item>
    </plurals>

    <!-- Counting how many items are in an misc list (eg playlists, years, etc) -->
    <plurals name="items">
        <item quantity="one">%d आइटम</item>
        <item quantity="other">%d आइटम</item>
    </plurals>

    <!-- Counting how many folders are in an folder list -->
    <plurals name="folders_plural">
        <item quantity="one">%d फ़ोल्डर</item>
        <item quantity="other">%d फ़ोल्डर</item>
    </plurals>

    <!-- Used in sleep timer dialog to show list of 1/2/3/5/10/15/etc minutes for user to quickly pick from -->
    <plurals name="minutes">
        <item quantity="one">%d मिनट</item>
        <item quantity="other">%d मिनट</item>
    </plurals>

</resources>
